pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 2, unit: 'HOURS')
        disableConcurrentBuilds()
    }

    environment {
        AWS_REGION      = 'us-east-1'
        ECR_REGISTRY    = '897545289989.dkr.ecr.us-east-1.amazonaws.com'
        CLUSTER_NAME    = "analytics-${params.ENVIRONMENT}"
        TF_STATE_BUCKET = 'analytics-tf-state-897545289989'
    }

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'stage', 'prod'], description: 'Target deployment environment / Terraform workspace')
        choice(name: 'ACTION', choices: ['plan', 'apply', 'destroy'], description: 'Terraform action to perform')
        booleanParam(name: 'RUN_TESTS', defaultValue: true, description: 'Run automated tests')
        booleanParam(name: 'SECURITY_SCAN', defaultValue: true, description: 'Run security scans')
        string(name: 'IMAGE_TAG', defaultValue: '${BUILD_ID}', description: 'Docker image tag')
    }

    stages {
        stage('Initialize') {
            steps {
                script {
                    // No withVault - AWS creds already live in the jenkins
                    // system user's ~/.aws/credentials (set up once, outside
                    // this pipeline). No explicit checkout either - Jenkins
                    // already pulled this repo into the workspace root to
                    // load this Jenkinsfile in the first place.
                    env.JENKINS_ROLE_ARN = sh(script: 'aws sts get-caller-identity --query Arn --output text', returnStdout: true).trim()
                    sh 'aws sts get-caller-identity'
                }
            }
        }

        stage('Security Scan') {
            // Checkov only here - it scans Terraform source, doesn't need a
            // built image. Trivy moved into Build & Test, right after the
            // image is actually built and before it's pushed - it used to
            // run here too, against a tag that couldn't exist yet (Security
            // Scan ran before Build & Test), so it always failed to find the
            // image and never scanned anything real. Confirmed via a real
            // pipeline run, 2026-09-18. SonarQube dropped - no server
            // available in this environment.
            when { expression { params.SECURITY_SCAN == true } }
            steps {
                script {
                    sh 'docker run --rm -v "${WORKSPACE}/product-infrastructure:/iac" bridgecrew/checkov -d /iac --compact || true'
                }
            }
        }

        stage('Build & Test') {
            steps {
                script {
                    if (params.RUN_TESTS) {
                        sh 'cd app/api && mvn -q test'
                    }
                    // Reuses the exact staging + build steps already verified
                    // working by hand - see §04 of docs/e2e-manual.html.
                    sh '''
                    cd product-docker
                    ./build-scripts/stage-local-app.sh
                    docker build --target api            -t ${ECR_REGISTRY}/analytics-api:${IMAGE_TAG} .
                    docker build --target webapp          -t ${ECR_REGISTRY}/analytics-web:${IMAGE_TAG} .
                    docker build --target data-processor  -t ${ECR_REGISTRY}/analytics-data-processor:${IMAGE_TAG} .
                    '''
                    if (params.SECURITY_SCAN) {
                        // Scans the image that was just actually built, locally -
                        // before it ever reaches the registry.
                        sh '''
                        docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
                            aquasec/trivy:latest image --exit-code 0 --severity HIGH,CRITICAL \
                            ${ECR_REGISTRY}/analytics-api:${IMAGE_TAG} || true
                        '''
                    }
                    sh '''
                    aws ecr get-login-password --region ${AWS_REGION} | \
                        docker login --username AWS --password-stdin ${ECR_REGISTRY}
                    docker push ${ECR_REGISTRY}/analytics-api:${IMAGE_TAG}
                    docker push ${ECR_REGISTRY}/analytics-web:${IMAGE_TAG}
                    docker push ${ECR_REGISTRY}/analytics-data-processor:${IMAGE_TAG}
                    '''
                }
            }
        }

        stage('Infrastructure Plan') {
            when { expression { params.ACTION in ['plan', 'apply'] } }
            steps {
                dir('product-infrastructure') {
                    sh """
                    terraform init \
                        -backend-config="bucket=${TF_STATE_BUCKET}" \
                        -backend-config="region=${AWS_REGION}"
                    terraform workspace select ${params.ENVIRONMENT} || terraform workspace new ${params.ENVIRONMENT}
                    terraform plan \
                        -var-file="environments/${params.ENVIRONMENT}/${params.ENVIRONMENT}.tfvars" \
                        -var="image_tag=${IMAGE_TAG}" \
                        -var="jenkins_role_arn=${env.JENKINS_ROLE_ARN}" \
                        -out=tfplan.binary
                    terraform show -json tfplan.binary > tfplan.json
                    """
                    archiveArtifacts artifacts: 'tfplan.json'
                }
            }
        }

        stage('Manual Approval') {
            when { expression { params.ENVIRONMENT == 'prod' && params.ACTION == 'apply' } }
            steps {
                timeout(time: 1, unit: 'HOURS') {
                    input message: 'Approve production deployment?', ok: 'Deploy to Production'
                }
            }
        }

        stage('Infrastructure Apply') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                dir('product-infrastructure') {
                    sh 'terraform apply -auto-approve tfplan.binary'
                }
            }
        }

        stage('Kubernetes Deploy') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                dir('product-kubernetes') {
                    sh """
                    aws eks update-kubeconfig --name ${CLUSTER_NAME} --region ${AWS_REGION}
                    kubectl create namespace analytics --dry-run=client -o yaml | kubectl apply -f -

                    sed -i "s#analytics-api:latest#${ECR_REGISTRY}/analytics-api:${IMAGE_TAG}#g" deployment.yaml
                    sed -i "s#analytics-web:latest#${ECR_REGISTRY}/analytics-web:${IMAGE_TAG}#g" deployment.yaml
                    sed -i "s#analytics-data-processor:latest#${ECR_REGISTRY}/analytics-data-processor:${IMAGE_TAG}#g" deployment.yaml

                    kubectl apply -f configmap.yaml
                    kubectl apply -f secrets.yaml
                    kubectl apply -f deployment.yaml
                    kubectl apply -f service.yaml
                    kubectl apply -f ingress.yaml

                    kubectl wait --for=condition=available --timeout=300s deployment/analytics-api -n analytics
                    kubectl wait --for=condition=available --timeout=300s deployment/analytics-web -n analytics

                    git checkout -- deployment.yaml
                    """
                }
            }
        }

        stage('Smoke Tests') {
            steps {
                script {
                    // Plain HTTP + explicit Host header - no ACM cert exists yet
                    // (see §08 of docs/e2e-manual.html). Switch to https + -f once
                    // a real certificate-arn replaces ingress.yaml's placeholder.
                    sh '''
                    API_URL=$(kubectl get ingress analytics-api -n analytics -o jsonpath='{.status.loadBalancer.ingress[0].hostname}')
                    curl -f -H "Host: api.analytics.company.com" http://${API_URL}/actuator/health

                    WEB_URL=$(kubectl get ingress analytics-web -n analytics -o jsonpath='{.status.loadBalancer.ingress[0].hostname}')
                    curl -f -H "Host: app.analytics.company.com" http://${WEB_URL}/health
                    '''
                }
            }
        }

        stage('Monitoring Setup') {
            steps {
                dir('monitoring') {
                    sh '''
                    helm repo add prometheus-community https://prometheus-community.github.io/helm-charts
                    helm repo update
                    helm upgrade --install monitoring prometheus-community/kube-prometheus-stack \
                        --namespace monitoring --create-namespace \
                        -f dashboards/kube-prometheus-stack-values.yaml

                    kubectl apply -k efk/

                    # kube-prometheus-stack only discovers scrape targets via
                    # ServiceMonitor/PodMonitor CRDs - without this,
                    # analytics-api never appears in Prometheus at all despite
                    # everything else succeeding (see §14 of docs/e2e-manual.html)
                    kubectl apply -f dashboards/analytics-api-servicemonitor.yaml

                    kubectl create configmap grafana-analytics-dashboard \
                        --from-file=dashboards/grafana-analytics-dashboard.json \
                        -n monitoring --dry-run=client -o yaml | kubectl apply -f -
                    '''
                }
            }
        }
    }

    post {
        always {
            sh 'docker system prune -f || true'
        }
        success {
            echo "✅ Deployment successful: ${env.JOB_NAME} #${env.BUILD_NUMBER} to ${params.ENVIRONMENT}"
            archiveArtifacts artifacts: '**/test-results/**/*.xml, **/coverage/**/*', allowEmptyArchive: true
        }
        failure {
            echo "❌ Deployment failed: ${env.JOB_NAME} #${env.BUILD_NUMBER} to ${params.ENVIRONMENT}"
            script {
                if (params.ENVIRONMENT == 'prod') {
                    sh '''
                    kubectl rollout undo deployment/analytics-api -n analytics
                    kubectl rollout undo deployment/analytics-web -n analytics
                    '''
                }
            }
        }
    }
}
