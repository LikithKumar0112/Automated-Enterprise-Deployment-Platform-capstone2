def notifySlack(String status, String message) {
    try {
        withCredentials([string(credentialsId: 'slack-webhook-url', variable: 'SLACK_WEBHOOK_URL')]) {
            sh "${env.SCRIPTS}/notify-slack.sh '${status}' '${message}'"
        }
    } catch (err) {
        // A Slack problem should not change the build result
        echo "Slack notification skipped: ${err.getMessage()}"
    }
}

pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 2, unit: 'HOURS')
        disableConcurrentBuilds()
    }

    environment {
        AWS_REGION      = 'us-east-1'
        ECR_REGISTRY    = '897545289989.dkr.ecr.us-east-1.amazonaws.com'
        TF_STATE_BUCKET = 'analytics-tf-state-897545289989'
        SCRIPTS         = 'product-deployment-pipeline/scripts'
    }

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'stage', 'prod'], description: 'Environment to deploy to')
        choice(name: 'ACTION', choices: ['plan', 'apply'], description: 'plan only shows changes, apply deploys')
        booleanParam(name: 'RUN_TESTS', defaultValue: true, description: 'Run automated tests')
        booleanParam(name: 'SECURITY_SCAN', defaultValue: true, description: 'Can only be turned off for dev')
        string(name: 'IMAGE_TAG', defaultValue: '${BUILD_ID}', description: 'Docker image tag')
    }

    stages {
        stage('Initialize') {
            steps {
                script {
                    if (params.ENVIRONMENT != 'dev' && !params.SECURITY_SCAN) {
                        error("SECURITY_SCAN cannot be turned off for ${params.ENVIRONMENT}")
                    }
                }
                sh 'aws sts get-caller-identity'
            }
        }

        stage('IaC Scan (Checkov)') {
            when { expression { params.SECURITY_SCAN } }
            steps {
                sh '$SCRIPTS/scan-iac.sh'
            }
        }

        stage('Dependency Scan (Snyk)') {
            when { expression { params.SECURITY_SCAN } }
            steps {
                withCredentials([string(credentialsId: 'snyk-api-token', variable: 'SNYK_TOKEN')]) {
                    sh 'snyk test --file=app/api/pom.xml --severity-threshold=high'
                    sh 'snyk test --file=app/data-processor/pom.xml --severity-threshold=high'
                }
            }
        }

        stage('Build & Test') {
            steps {
                script {
                    if (params.RUN_TESTS) {
                        sh 'cd app/api && mvn -q test'
                        sh 'cd app/data-processor && mvn -q test'
                    }
                }
                sh '$SCRIPTS/build-images.sh'
            }
        }

        stage('Image Scan (Trivy)') {
            when { expression { params.SECURITY_SCAN } }
            steps {
                sh '$SCRIPTS/scan-image.sh $ECR_REGISTRY/analytics-api:$IMAGE_TAG'
                sh '$SCRIPTS/scan-image.sh $ECR_REGISTRY/analytics-web:$IMAGE_TAG'
                sh '$SCRIPTS/scan-image.sh $ECR_REGISTRY/analytics-data-processor:$IMAGE_TAG'
            }
        }

        stage('Push Images') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                sh '$SCRIPTS/push-images.sh'
            }
        }

        stage('Infrastructure Plan') {
            steps {
                sh '$SCRIPTS/terraform-plan.sh'
                archiveArtifacts artifacts: 'product-infrastructure/tfplan.json'
            }
        }

        stage('Manual Approval') {
            when { expression { params.ENVIRONMENT == 'prod' && params.ACTION == 'apply' } }
            steps {
                timeout(time: 1, unit: 'HOURS') {
                    input message: 'Approve production deployment?', ok: 'Deploy to Production'
                }
            }
        }

        stage('Infrastructure Apply') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                sh 'cd product-infrastructure && terraform apply -auto-approve tfplan.binary'
            }
        }

        stage('Kubernetes Deploy') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                sh 'aws eks update-kubeconfig --name analytics-$ENVIRONMENT --region $AWS_REGION'
                sh '$SCRIPTS/sync-secrets.sh $ENVIRONMENT'
                script { env.ROLLBACK_NEEDED = 'true' }
                sh '$SCRIPTS/k8s-deploy.sh'
            }
        }

        stage('Smoke Tests') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                sh '$SCRIPTS/smoke-test.sh'
                // The new version works, so a later failure should not roll it back
                script { env.ROLLBACK_NEEDED = 'false' }
            }
        }

        stage('Monitoring Setup') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                withCredentials([string(credentialsId: 'slack-webhook-url', variable: 'SLACK_WEBHOOK_URL')]) {
                    sh '$SCRIPTS/setup-monitoring.sh'
                }
            }
        }
    }

    post {
        always {
            sh 'docker system prune -f || true'
        }
        success {
            script {
                def result = params.ACTION == 'apply' ? 'Deployment succeeded' : 'Plan succeeded (nothing deployed)'
                echo "${result}: ${params.ENVIRONMENT}, build #${env.BUILD_NUMBER}"
                notifySlack('SUCCESS', "${result}: ${params.ENVIRONMENT}, build #${env.BUILD_NUMBER}")
            }
        }
        failure {
            script {
                def message = "${params.ENVIRONMENT}, build #${env.BUILD_NUMBER}, ACTION=${params.ACTION}: no rollback performed"
                if (env.ROLLBACK_NEEDED == 'true') {
                    def status = sh(script: '$SCRIPTS/rollback.sh $ENVIRONMENT', returnStatus: true)
                    message = "${params.ENVIRONMENT}, build #${env.BUILD_NUMBER}: " +
                        (status == 0 ? 'rolled back to the previous version' : 'ROLLBACK FAILED, fix manually')
                }
                echo "Build failed: ${message}"
                notifySlack('FAILED', message)
            }
        }
    }
}
