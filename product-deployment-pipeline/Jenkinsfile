pipeline {
    agent {
        kubernetes {
            label 'enterprise-deployment-agent'
            yaml '''
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins-agent
  containers:
  - name: jnlp
    image: jenkins/inbound-agent:4.10-3-alpine
    args: ['$(JENKINS_SECRET)', '$(JENKINS_NAME)']
    resources:
      limits: {cpu: 500m, memory: 1Gi}
      requests: {cpu: 200m, memory: 512Mi}
  - name: terraform
    image: hashicorp/terraform:1.3
    command: ['cat']
    tty: true
  - name: kubectl
    image: bitnami/kubectl:1.24
    command: ['cat']
    tty: true
  - name: docker
    image: docker:20.10-dind
    securityContext: {privileged: true}
    env:
    - name: DOCKER_TLS_CERTDIR
      value: ""
  - name: maven
    image: maven:3.8-openjdk-11
    command: ['cat']
    tty: true
'''
        }
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 2, unit: 'HOURS')
        retry(3)
        disableConcurrentBuilds()
    }

    environment {
        AWS_REGION       = 'us-east-1'
        ECR_REGISTRY     = '123456789012.dkr.ecr.us-east-1.amazonaws.com'
        CLUSTER_NAME     = "analytics-${params.ENVIRONMENT}"
        TF_STATE_BUCKET  = "analytics-tf-state-${AWS_ACCOUNT_ID}"
        VAULT_ADDR       = 'https://vault.company.com:8200'
    }

    parameters {
        // "stage" (not "staging") to match product-infrastructure/environments/
        choice(name: 'ENVIRONMENT', choices: ['dev', 'stage', 'prod'], description: 'Target deployment environment / Terraform workspace')
        choice(name: 'ACTION', choices: ['plan', 'apply', 'destroy'], description: 'Terraform action to perform')
        booleanParam(name: 'RUN_TESTS', defaultValue: true, description: 'Run automated tests')
        booleanParam(name: 'SECURITY_SCAN', defaultValue: true, description: 'Run security scans')
        string(name: 'IMAGE_TAG', defaultValue: '${BUILD_ID}', description: 'Docker image tag')
    }

    stages {
        stage('Initialize') {
            steps {
                script {
                    withVault([
                        configuration: [timeout: 60],
                        vaultSecrets: [
                            [path: "secret/aws/${params.ENVIRONMENT}", engineVersion: 2, secretValues: [
                                [envVar: 'AWS_ACCESS_KEY_ID', vaultKey: 'aws_access_key_id'],
                                [envVar: 'AWS_SECRET_ACCESS_KEY', vaultKey: 'aws_secret_access_key']
                            ]],
                            [path: "secret/kubernetes/${params.ENVIRONMENT}", engineVersion: 2, secretValues: [
                                [envVar: 'KUBECONFIG', vaultKey: 'kubeconfig']
                            ]]
                        ]
                    ])
                    sh '''
                    aws configure set aws_access_key_id ${AWS_ACCESS_KEY_ID}
                    aws configure set aws_secret_access_key ${AWS_SECRET_ACCESS_KEY}
                    aws configure set region ${AWS_REGION}
                    '''
                    writeFile file: 'kubeconfig.yaml', text: env.KUBECONFIG
                    env.KUBECONFIG = 'kubeconfig.yaml'
                }

                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    extensions: [[$class: 'RelativeTargetDirectory', relativeTargetDir: 'infra']],
                    userRemoteConfigs: [[url: 'https://github.com/SkillfymeLearning/Enterprise-Deployment-Platform.git']]
                ])

                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    extensions: [[$class: 'RelativeTargetDirectory', relativeTargetDir: 'app']],
                    userRemoteConfigs: [[url: 'https://github.com/company/analytics-app.git']]
                ])
            }
        }

        stage('Security Scan') {
            when { expression { params.SECURITY_SCAN == true } }
            steps {
                script {
                    withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                        sh '''
                        cd app
                        mvn sonar:sonar -Dsonar.projectKey=analytics-platform \
                            -Dsonar.host.url=https://sonar.company.com -Dsonar.login=${SONAR_TOKEN}
                        '''
                    }
                    sh '''
                    docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
                        aquasec/trivy:latest image --exit-code 1 --severity HIGH,CRITICAL \
                        ${ECR_REGISTRY}/analytics-api:${IMAGE_TAG}
                    docker run --rm -v "${WORKSPACE}/infra/product-infrastructure:/iac" bridgecrew/checkov -d /iac
                    '''
                }
            }
        }

        stage('Build & Test') {
            steps {
                script {
                    dir('app') {
                        sh 'mvn clean package -DskipTests=false'
                        if (params.RUN_TESTS) {
                            sh 'mvn test'
                            junit 'target/surefire-reports/*.xml'
                        }
                    }
                    // Single multi-target Dockerfile in product-docker/ builds all three images
                    sh '''
                    cp -r app/target infra/product-docker/target
                    cd infra/product-docker
                    docker build --target api            -t ${ECR_REGISTRY}/analytics-api:${IMAGE_TAG} .
                    docker build --target webapp          -t ${ECR_REGISTRY}/analytics-web:${IMAGE_TAG} .
                    docker build --target data-processor  -t ${ECR_REGISTRY}/analytics-data-processor:${IMAGE_TAG} .

                    aws ecr get-login-password --region ${AWS_REGION} | \
                        docker login --username AWS --password-stdin ${ECR_REGISTRY}
                    docker push ${ECR_REGISTRY}/analytics-api:${IMAGE_TAG}
                    docker push ${ECR_REGISTRY}/analytics-web:${IMAGE_TAG}
                    docker push ${ECR_REGISTRY}/analytics-data-processor:${IMAGE_TAG}
                    '''
                }
            }
        }

        stage('Infrastructure Plan') {
            when { expression { params.ACTION in ['plan', 'apply'] } }
            steps {
                script {
                    dir('infra/product-infrastructure') {
                        sh """
                        terraform init \
                            -backend-config="bucket=${TF_STATE_BUCKET}" \
                            -backend-config="region=${AWS_REGION}"
                        terraform workspace select ${params.ENVIRONMENT} || terraform workspace new ${params.ENVIRONMENT}
                        terraform plan \
                            -var-file="environments/${params.ENVIRONMENT}/${params.ENVIRONMENT}.tfvars" \
                            -var="image_tag=${IMAGE_TAG}" \
                            -out=tfplan.binary
                        terraform show -json tfplan.binary > tfplan.json
                        """
                        archiveArtifacts artifacts: 'tfplan.json'
                    }
                }
            }
        }

        stage('Manual Approval') {
            when { expression { params.ENVIRONMENT == 'prod' && params.ACTION == 'apply' } }
            steps {
                timeout(time: 1, unit: 'HOURS') {
                    input message: 'Approve production deployment?', ok: 'Deploy to Production'
                }
            }
        }

        stage('Infrastructure Apply') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                script {
                    dir('infra/product-infrastructure') {
                        sh 'terraform apply -auto-approve tfplan.binary'
                        sh 'terraform output -json > outputs.json'
                        def outputs = readJSON file: 'outputs.json'
                        env.K8S_CLUSTER_ENDPOINT = outputs.cluster_endpoint.value
                    }
                }
            }
        }

        stage('Kubernetes Deploy') {
            when { expression { params.ACTION == 'apply' } }
            steps {
                script {
                    sh "aws eks update-kubeconfig --name ${CLUSTER_NAME} --region ${AWS_REGION}"

                    // No Kustomize - product-kubernetes/ is a flat set of manifests,
                    // so the image tag is substituted in place before apply.
                    dir('infra/product-kubernetes') {
                        sh """
                        kubectl create namespace analytics --dry-run=client -o yaml | kubectl apply -f -
                        sed -i "s#analytics-api:latest#${ECR_REGISTRY}/analytics-api:${IMAGE_TAG}#g" deployment.yaml
                        sed -i "s#analytics-web:latest#${ECR_REGISTRY}/analytics-web:${IMAGE_TAG}#g" deployment.yaml
                        sed -i "s#analytics-data-processor:latest#${ECR_REGISTRY}/analytics-data-processor:${IMAGE_TAG}#g" deployment.yaml

                        kubectl apply -f configmap.yaml
                        kubectl apply -f secrets.yaml
                        kubectl apply -f deployment.yaml
                        kubectl apply -f service.yaml
                        kubectl apply -f ingress.yaml

                        kubectl wait --for=condition=available --timeout=300s deployment/analytics-api -n analytics
                        kubectl wait --for=condition=available --timeout=300s deployment/analytics-web -n analytics

                        git checkout -- deployment.yaml
                        """
                    }
                }
            }
        }

        stage('Smoke Tests') {
            steps {
                script {
                    sh '''
                    API_URL=$(kubectl get ingress analytics-api -n analytics -o jsonpath='{.status.loadBalancer.ingress[0].hostname}')
                    curl -f https://${API_URL}/actuator/health || exit 1

                    WEB_URL=$(kubectl get ingress analytics-web -n analytics -o jsonpath='{.status.loadBalancer.ingress[0].hostname}')
                    curl -f https://${WEB_URL}/health || exit 1
                    '''
                }
            }
        }

        stage('Monitoring Setup') {
            steps {
                script {
                    dir('infra/monitoring') {
                        sh '''
                        kubectl apply -k efk/
                        kubectl apply -f dashboards/ -n monitoring
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            sh '''
            docker system prune -f
            rm -f kubeconfig.yaml
            '''
            script {
                def status = currentBuild.currentResult
                def duration = currentBuild.duration
                sh """
                curl -X POST https://monitoring.company.com/metrics \
                    -d 'deployment_duration_seconds{environment="${params.ENVIRONMENT}"} ${duration/1000}' \
                    -d 'deployment_status{environment="${params.ENVIRONMENT}",status="${status}"} 1'
                """
            }
        }
        success {
            slackSend(channel: '#deployments', color: 'good',
                message: "✅ Deployment successful: ${env.JOB_NAME} #${env.BUILD_NUMBER} to ${params.ENVIRONMENT}")
            archiveArtifacts artifacts: '**/test-results/**/*.xml, **/coverage/**/*', allowEmptyArchive: true
        }
        failure {
            slackSend(channel: '#deployments-alerts', color: 'danger',
                message: "❌ Deployment failed: ${env.JOB_NAME} #${env.BUILD_NUMBER} to ${params.ENVIRONMENT}")
            script {
                if (params.ENVIRONMENT == 'prod') {
                    sh '''
                    kubectl rollout undo deployment/analytics-api -n analytics
                    kubectl rollout undo deployment/analytics-web -n analytics
                    '''
                }
            }
        }
    }
}
